# ==============================================================================
# AGRICULTURE PRODUCT MANUFACTURING PLATFORM - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or actual secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC APPLICATION METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="[Company Name Placeholder]"
NEXT_PUBLIC_APP_ENV="development"

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT SDK (Phase 2)
# Safe for browser context; security is enforced via Firestore Security Rules
# and server-side token verification.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_placeholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id_placeholder"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id_placeholder"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id_placeholder"

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (Phase 2 & 3 - SERVER-ONLY)
# CRITICAL: Never prefix these with NEXT_PUBLIC_. Used only in server routes/actions.
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="your_project_id_placeholder"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_PLACEHOLDER\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. ANTHROPIC CLAUDE API (Planned - Phase 8 - SERVER-ONLY)
# CRITICAL: Server-side only for company-specific agricultural AI guidance.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-placeholder-do-not-commit-real-key"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (Planned - Phase 6 & 11)
# CRITICAL: RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are SERVER-ONLY.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder_server_only"
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret_placeholder_server_only"

# ------------------------------------------------------------------------------
# 6. OFFICIAL WHATSAPP BUSINESS CLOUD API (Planned - Phase 9 - SERVER-ONLY)
# ------------------------------------------------------------------------------
WHATSAPP_BUSINESS_ACCOUNT_ID="whatsapp_business_account_id_placeholder"
WHATSAPP_PHONE_NUMBER_ID="whatsapp_phone_number_id_placeholder"
WHATSAPP_ACCESS_TOKEN="whatsapp_system_user_token_placeholder_server_only"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="whatsapp_webhook_verify_token_placeholder"
